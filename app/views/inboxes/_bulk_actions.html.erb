<div class="mb-3 flex items-center justify-between rounded-lg border border-gray-200 bg-white px-4 py-2.5 shadow-sm">
  <div class="flex items-center gap-x-3">
    <input type="checkbox" id="select-all"
           class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
           data-action="change->bulk-actions#selectAll"
           data-bulk-actions-target="selectAll">
    <label for="select-all" class="text-sm text-gray-700">
      <span class="font-medium"><%= count %></span> items
    </label>
  </div>

  <div class="flex items-center gap-x-2">
    <button type="button"
            title="<%= filter == 'processed' ? 'Reprocess selected (p)' : 'Process selected (p)' %>"
            class="inline-flex items-center gap-x-1.5 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 shadow-sm hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors duration-150"
            disabled
            data-bulk-actions-target="actionButton"
            data-keyboard-shortcuts-target="trigger"
            data-keyboard-shortcuts-key="p"
            data-action="click->bulk-actions#bulkProcess">
      <svg class="-ml-0.5 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.75a.75.75 0 0 0-.75.75v4.482a.75.75 0 0 0 1.5 0v-2.22l.334.333a7 7 0 0 0 11.96-3.23.75.75 0 1 0-1.482-.27Zm-10.624-2.85a5.5 5.5 0 0 1 9.2-2.465l.313.31h-2.433a.75.75 0 0 0 0 1.5h4.482a.75.75 0 0 0 .75-.75V2.688a.75.75 0 0 0-1.5 0v2.22l-.334-.333a7 7 0 0 0-11.96 3.23.75.75 0 0 0 1.482.27Z" clip-rule="evenodd" />
      </svg>
      <%= filter == 'processed' ? 'Reprocess' : 'Process' %>
      <kbd class="ml-1 hidden rounded border border-gray-200 bg-gray-100 px-1 py-0.5 font-mono text-xs font-normal text-gray-500 sm:inline">p</kbd>
    </button>
    <% if filter == 'archived' %>
    <button type="button"
            title="Unarchive selected (a)"
            class="inline-flex items-center gap-x-1.5 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 shadow-sm hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors duration-150"
            disabled
            data-bulk-actions-target="actionButton"
            data-keyboard-shortcuts-target="trigger"
            data-keyboard-shortcuts-key="a"
            data-action="click->bulk-actions#bulkUnarchive">
      <svg class="-ml-0.5 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path d="M2 3a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H2Z" />
        <path fill-rule="evenodd" d="M2 7.5h16l-.811 7.71a2 2 0 0 1-1.99 1.79H4.802a2 2 0 0 1-1.99-1.79L2 7.5ZM7 11a1 1 0 0 1 1-1h4a1 1 0 1 1 0 2H8a1 1 0 0 1-1-1Z" clip-rule="evenodd" />
      </svg>
      Unarchive
      <kbd class="ml-1 hidden rounded border border-gray-200 bg-gray-100 px-1 py-0.5 font-mono text-xs font-normal text-gray-500 sm:inline">a</kbd>
    </button>
    <% else %>
    <button type="button"
            title="Archive selected (a)"
            class="inline-flex items-center gap-x-1.5 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-600 shadow-sm hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors duration-150"
            disabled
            data-bulk-actions-target="actionButton"
            data-keyboard-shortcuts-target="trigger"
            data-keyboard-shortcuts-key="a"
            data-action="click->bulk-actions#bulkArchive">
      <svg class="-ml-0.5 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path d="M2 3a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H2Z" />
        <path fill-rule="evenodd" d="M2 7.5h16l-.811 7.71a2 2 0 0 1-1.99 1.79H4.802a2 2 0 0 1-1.99-1.79L2 7.5ZM7 11a1 1 0 0 1 1-1h4a1 1 0 1 1 0 2H8a1 1 0 0 1-1-1Z" clip-rule="evenodd" />
      </svg>
      Archive
      <kbd class="ml-1 hidden rounded border border-gray-200 bg-gray-100 px-1 py-0.5 font-mono text-xs font-normal text-gray-500 sm:inline">a</kbd>
    </button>
    <% end %>
    <button type="button"
            title="Delete selected (d)"
            class="inline-flex items-center gap-x-1.5 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-red-600 shadow-sm hover:bg-red-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors duration-150"
            disabled
            data-bulk-actions-target="actionButton"
            data-keyboard-shortcuts-target="trigger"
            data-keyboard-shortcuts-key="d"
            data-action="click->bulk-actions#bulkDelete">
      <svg class="-ml-0.5 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" />
      </svg>
      Delete
      <kbd class="ml-1 hidden rounded border border-gray-200 bg-gray-100 px-1 py-0.5 font-mono text-xs font-normal text-gray-500 sm:inline">d</kbd>
    </button>
  </div>
</div>
