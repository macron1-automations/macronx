#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  # tmp/ is bind-mounted from the host, so a pidfile left behind by a container
  # that was killed rather than stopped names PID 1 -- which always exists in a
  # new container -- and Rails aborts with "A server is already running".
  rm -f tmp/pids/server.pid
  ./bin/rails db:prepare
fi

exec "${@}"
